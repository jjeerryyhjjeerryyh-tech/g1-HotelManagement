/**
 * 通知页面样式
 * 与 Book.css 视觉风格保持一致
 * 使用与 Book.html 相同的 CSS 变量和组件设计语言
 */

/* ================================
   CSS 变量（与 Book.css 一致）
================================ */
:root {
    --primary: #e67e22;
    --primary-dark: #d96d12;
    --success: #10b981;
    --warning: #f59e0b;
    --danger: #ef4444;
    --info: #06b6d4;
    --gray-100: #faf7f2;
    --gray-200: #f1e9de;
    --gray-300: #e0d6cc;
    --gray-600: #7f8c8d;
    --gray-800: #4a4a4a;
    --surface: rgba(255, 250, 240, 0.86);
    --surface-solid: #fffaf0;
    --shadow: 0 10px 28px rgba(0, 0, 0, 0.07);
    --shadow-lg: 0 20px 60px rgba(0, 0, 0, 0.16);
    --star: #fbbf24;
    --star-empty: #d1d5db;
    --radius: 12px;
    --radius-sm: 8px;
    --font: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

[data-theme="dark"] {
    --primary: #ffb347;
    --primary-dark: #f0a133;
    --success: #34d399;
    --warning: #fbbf24;
    --danger: #fb7185;
    --info: #22d3ee;
    --gray-100: #2c2c2c;
    --gray-200: #363636;
    --gray-300: #5a5a5a;
    --gray-600: #b0b0b0;
    --gray-800: #f0f0f0;
    --surface: rgba(44, 44, 44, 0.86);
    --surface-solid: #2c2c2c;
    --shadow: 0 12px 30px rgba(0, 0, 0, 0.45);
    --shadow-lg: 0 28px 80px rgba(0, 0, 0, 0.6);
}

/* ================================
   全局重置
================================ */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: var(--font);
    background: var(--gray-100);
    background-image:
        radial-gradient(circle at 12% 18%, rgba(230, 126, 34, 0.18) 0%, transparent 42%),
        radial-gradient(circle at 88% 82%, rgba(230, 126, 34, 0.14) 0%, transparent 46%);
    color: var(--gray-800);
    line-height: 1.6;
    min-height: 100vh;
}

/* ================================
   Header（与 Book.css 完全一致）
================================ */
.header {
    background: var(--surface);
    color: var(--gray-800);
    padding: 1.1rem 2rem;
    box-shadow: var(--shadow);
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid var(--gray-300);
    backdrop-filter: blur(12px);
}

.header-content {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    color: var(--gray-800);
    transition: opacity 0.3s ease;
}

.logo:hover {
    opacity: 0.8;
}

.logo-main {
    font-size: 20px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 400;
}

.logo-sub {
    font-size: 10px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    font-weight: 300;
    margin-top: 4px;
}

.header-right {
    display: flex;
    align-items: center;
}

.header-links {
    display: flex;
    align-items: center;
    gap: 24px;
}

.header-link {
    text-decoration: none;
    color: var(--gray-800);
    font-size: 13px;
    letter-spacing: 0.05em;
    transition: color 0.3s;
    display: flex;
    align-items: center;
    gap: 6px;
}

.header-link:hover {
    color: var(--primary);
}

.header-link i {
    font-size: 10px;
}

.icon-btn {
    background: transparent;
    border: none;
    color: var(--gray-800);
    font-size: 18px;
    cursor: pointer;
    transition: color 0.3s;
    display: flex;
    align-items: center;
    justify-content: center;
}

.icon-btn:hover {
    color: var(--primary);
}

.user-menu-container {
    position: relative;
}

.user-dropdown {
    position: absolute;
    top: calc(100% + 12px);
    right: 0;
    background: var(--surface);
    border: 1px solid var(--gray-300);
    box-shadow: var(--shadow-lg);
    border-radius: 4px;
    width: 200px;
    z-index: 1000;
}

.dropdown-item {
    display: block;
    padding: 12px 20px;
    color: var(--gray-600);
    text-decoration: none;
    font-size: 14px;
    transition: color 0.3s, background 0.3s;
}

.dropdown-item:hover {
    color: var(--primary);
    background: rgba(230, 126, 34, 0.06);
}

/* ================================
   语言下拉菜单（与 Book.css 完全一致）
================================ */
.lang-menu-container {
    position: relative;
}

.lang-dropdown {
    position: absolute;
    top: 100%;
    right: 0;
    margin-top: 15px;
    background: var(--surface);
    border: 1px solid var(--gray-300);
    box-shadow: var(--shadow-lg);
    border-radius: 4px;
    width: 240px;
    z-index: 1000;
    display: flex;
    flex-direction: column;
}

.lang-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 24px 10px;
    border-bottom: 1px solid var(--gray-200);
}

.lang-header h3 {
    margin: 0;
    font-size: 16px;
    font-weight: 500;
    color: var(--gray-800);
}

.lang-body {
    padding: 16px 24px;
}

.lang-list {
    list-style: none;
    padding: 0;
    margin: 0;
}

.lang-item {
    display: block;
    padding: 12px 0;
    color: var(--gray-600);
    text-decoration: none;
    font-size: 14px;
    transition: color 0.3s;
}

.lang-item:hover {
    color: var(--primary);
}

.lang-item.active {
    color: var(--gray-100);
    background-color: var(--gray-600);
    padding: 10px 12px;
    margin: 0 -12px;
    border-radius: 2px;
}

.close-dropdown {
    background: transparent;
    border: none;
    font-size: 18px;
    color: var(--gray-500);
    cursor: pointer;
    transition: color 0.3s;
}

.close-dropdown:hover {
    color: var(--gray-800);
}

/* ================================
   主内容区
================================ */
.page-wrapper {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 4rem;
}

/* 页面标题栏 */
.page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
}

.page-title {
    display: flex;
    align-items: center;
    gap: 0.75rem;
}

.page-title .title-icon {
    font-size: 1.8rem;
}

.page-title h1 {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--gray-800);
    letter-spacing: -0.02em;
}

.page-actions {
    display: flex;
    gap: 0.75rem;
}

/* ================================
   按钮（与 Book.css btn 一致）
================================ */
.btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 1.2rem;
    border: none;
    border-radius: var(--radius-sm);
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s, transform 0.1s, box-shadow 0.2s;
    text-decoration: none;
    line-height: 1;
    font-family: var(--font);
}

.btn:active { transform: translateY(1px); }

.btn-primary {
    background: var(--primary);
    color: #fff;
    box-shadow: 0 2px 8px rgba(230, 126, 34, 0.3);
}
.btn-primary:hover {
    background: var(--primary-dark);
    box-shadow: 0 4px 12px rgba(230, 126, 34, 0.4);
}

.btn-outline {
    background: transparent;
    color: var(--gray-800);
    border: 1.5px solid var(--gray-300);
}
.btn-outline:hover {
    border-color: var(--primary);
    color: var(--primary);
    background: rgba(230, 126, 34, 0.05);
}

.btn-danger {
    background: var(--danger);
    color: #fff;
}
.btn-danger:hover {
    background: #dc2626;
}

/* ================================
   统计卡片
================================ */
.message-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    margin-bottom: 1.75rem;
}

.stat-card {
    background: var(--surface);
    border: 1px solid var(--gray-300);
    border-radius: var(--radius);
    padding: 1.5rem;
    text-align: center;
    box-shadow: var(--shadow);
    transition: transform 0.2s;
}

.stat-card:hover { transform: translateY(-2px); }

.stat-number {
    display: block;
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--primary);
    line-height: 1;
    margin-bottom: 0.4rem;
    letter-spacing: -0.02em;
}

.stat-number.unread { color: var(--danger); }

.stat-label {
    color: var(--gray-600);
    font-size: 0.85rem;
    font-weight: 500;
}

/* ================================
   筛选栏
================================ */
.message-filters {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
}

.filter-btn {
    padding: 0.45rem 1rem;
    border: 1.5px solid var(--gray-300);
    background: var(--surface);
    color: var(--gray-600);
    border-radius: 20px;
    cursor: pointer;
    font-size: 0.85rem;
    font-weight: 500;
    transition: all 0.2s;
    font-family: var(--font);
}

.filter-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
}

.filter-btn.active {
    background: var(--primary);
    color: #fff;
    border-color: var(--primary);
    box-shadow: 0 2px 8px rgba(230, 126, 34, 0.3);
}

/* ================================
   消息列表容器
================================ */
.messages-container {
    background: var(--surface);
    border: 1px solid var(--gray-300);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    overflow: hidden;
}

.messages-list {
    max-height: 560px;
    overflow-y: auto;
}

/* ================================
   消息项
================================ */
.message-item {
    display: flex;
    align-items: flex-start;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--gray-200);
    cursor: pointer;
    transition: background 0.15s;
    position: relative;
}

.message-item:last-child { border-bottom: none; }

.message-item:hover { background: rgba(230, 126, 34, 0.04); }

.message-item.unread {
    background: rgba(230, 126, 34, 0.06);
    border-left: 3px solid var(--primary);
}

.message-item.unread .message-title { color: var(--gray-800); font-weight: 700; }

.message-icon {
    font-size: 1.5rem;
    margin-right: 1rem;
    margin-top: 0.1rem;
    flex-shrink: 0;
}

.message-content { flex: 1; min-width: 0; }

.message-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 0.3rem;
    gap: 0.5rem;
}

.message-title {
    font-weight: 600;
    color: var(--gray-800);
    font-size: 0.95rem;
    line-height: 1.3;
}

.message-time {
    font-size: 0.75rem;
    color: var(--gray-600);
    white-space: nowrap;
    flex-shrink: 0;
}

.message-text {
    color: var(--gray-600);
    font-size: 0.85rem;
    line-height: 1.5;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.message-type-badge {
    display: inline-block;
    margin-top: 0.4rem;
    padding: 0.15rem 0.6rem;
    background: var(--gray-200);
    color: var(--gray-600);
    border-radius: 12px;
    font-size: 0.72rem;
    font-weight: 600;
}

/* 操作按钮 */
.message-actions {
    display: flex;
    gap: 0.4rem;
    margin-left: 1rem;
    flex-shrink: 0;
    opacity: 0;
    transition: opacity 0.2s;
    align-items: center;
}

.message-item:hover .message-actions { opacity: 1; }

.action-btn {
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--gray-300);
    background: var(--surface-solid);
    color: var(--gray-600);
    border-radius: 6px;
    cursor: pointer;
    font-size: 0.78rem;
    font-weight: 500;
    transition: all 0.2s;
    font-family: var(--font);
}

.action-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
}

.action-btn.mark-read-btn:hover {
    background: rgba(230, 126, 34, 0.08);
}

.action-btn.delete-btn:hover {
    border-color: var(--danger);
    color: var(--danger);
}

/* ================================
   空状态
================================ */
.empty-state {
    text-align: center;
    padding: 4rem 2rem;
    color: var(--gray-600);
}

.empty-icon { font-size: 3.5rem; margin-bottom: 0.75rem; }
.empty-state h3 { font-size: 1.1rem; margin-bottom: 0.4rem; color: var(--gray-800); }
.empty-state p { font-size: 0.9rem; }

/* ================================
   加载状态
================================ */
.loading-state {
    text-align: center;
    padding: 3rem;
    color: var(--gray-600);
}

.loading-spinner {
    width: 36px;
    height: 36px;
    border: 3px solid var(--gray-200);
    border-top-color: var(--primary);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    margin: 0 auto 0.75rem;
}

@keyframes spin { to { transform: rotate(360deg); } }

/* ================================
   模态框
================================ */
.modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 1000;
    padding: 1rem;
}

.modal {
    background: var(--surface-solid);
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
    max-width: 500px;
    width: 100%;
    max-height: 80vh;
    overflow: hidden;
    border: 1px solid var(--gray-300);
}

.modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--gray-200);
}

.modal-header h3 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--gray-800);
}

.modal-close {
    background: none;
    border: none;
    font-size: 1.25rem;
    cursor: pointer;
    color: var(--gray-600);
    padding: 0.2rem;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    transition: background 0.2s;
}
.modal-close:hover { background: var(--gray-200); color: var(--gray-800); }

.modal-body {
    padding: 1.5rem;
    max-height: 380px;
    overflow-y: auto;
    line-height: 1.7;
    color: var(--gray-800);
}

.modal-body .message-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--gray-200);
}

.modal-type {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    background: var(--primary);
    color: #fff;
    border-radius: 12px;
    font-size: 0.75rem;
    font-weight: 600;
}

.modal-time { font-size: 0.8rem; color: var(--gray-600); }

.modal-footer {
    display: flex;
    justify-content: flex-end;
    gap: 0.6rem;
    padding: 1rem 1.5rem;
    border-top: 1px solid var(--gray-200);
    background: var(--gray-100);
}

/* ================================
   确认对话框
================================ */
#confirmModal .modal-body {
    padding: 1.75rem 1.5rem;
    text-align: center;
    font-size: 0.95rem;
}

/* ================================
   用户信息栏
================================ */
.user-greeting {
    font-size: 0.85rem;
    color: var(--gray-600);
    margin-bottom: 0.5rem;
}

/* ================================
   语言下拉菜单（与 Book.css 一致）
================================ */
.lang-menu-container {
    position: relative;
}

.lang-dropdown {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    background: var(--surface-solid);
    border: 1px solid var(--gray-300);
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
    min-width: 160px;
    z-index: 9999;
    overflow: hidden;
}

.lang-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--gray-200);
}

.lang-header h3 {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--gray-800);
    margin: 0;
}

.close-dropdown {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--gray-600);
    font-size: 0.9rem;
    padding: 0.2rem;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s, color 0.2s;
}

.close-dropdown:hover {
    background: var(--gray-200);
    color: var(--gray-800);
}

.lang-body {
    padding: 0.5rem 0;
}

.lang-list {
    list-style: none;
    margin: 0;
    padding: 0;
}

/* ================================
   响应式
================================ */
@media (max-width: 640px) {
    .page-wrapper { padding: 1.5rem 1rem 3rem; }
    .page-header { flex-direction: column; align-items: flex-start; gap: 1rem; }
    .message-stats { grid-template-columns: 1fr; }
    .message-item { flex-wrap: wrap; gap: 0.75rem; }
    .message-actions { opacity: 1; flex-wrap: wrap; }
    .header { padding: 1rem; }
    .page-title h1 { font-size: 1.4rem; }
    .stat-number { font-size: 2rem; }
}
