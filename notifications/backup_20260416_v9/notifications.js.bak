/**
 * 通知页面交互逻辑 v2.3
 * 依赖：lang.js、notificationSystem.js（必须在此前加载）
 */

(function () {
    'use strict';

    // ============================================
    // 翻译函数（代理到 lang.js）
    // ============================================
    function t(key) {
        return (window.__notifLang && window.__notifLang.t)
            ? window.__notifLang.t(key)
            : key;
    }

    function getLang() {
        return (window.__notifLang && window.__notifLang.getLang)
            ? window.__notifLang.getLang()
            : (localStorage.getItem('lang') || 'zh');
    }

    // ============================================
    // 工具函数
    // ============================================
    function getTypeText(type) {
        var map = {
            'login_success':    t('login_notif'),
            'booking_success':  t('booking_notif'),
            'profile_update':   t('profile_notif'),
            'admin_login':      t('profile_notif'),
            'first_login':      t('profile_notif')
        };
        return map[type] || t('profile_notif');
    }

    function getNotificationIcon(type) {
        var icons = {
            'login_success':    '&#128274;',
            'booking_success':  '&#127968;',
            'profile_update':    '&#128100;',
            'admin_login':       '&#9881;',
            'first_login':       '&#127882;'
        };
        return icons[type] || '&#128228;';
    }

    function formatTime(timestamp) {
        var date  = new Date(timestamp);
        var now   = new Date();
        var diff  = now - date;
        var mins  = Math.floor(diff / 60000);
        var hours = Math.floor(diff / 3600000);
        var days  = Math.floor(diff / 86400000);

        if (mins < 1)            return t('just_now') || 'Just now';
        if (mins < 60)          return String(mins)  + (getLang() === 'en' ? ' min ago' : '分钟前');
        if (hours < 24)          return String(hours) + (getLang() === 'en' ? ' hr ago' : '小时前');
        if (days < 7)           return String(days)  + (getLang() === 'en' ? ' days ago' : '天前');

        return date.toLocaleDateString(getLang() === 'en' ? 'en-US' : 'zh-CN', {
            year:   'numeric',
            month:  'short',
            day:    'numeric',
            hour:   '2-digit',
            minute: '2-digit'
        });
    }

    // ============================================
    // 页面文案刷新（切换语言时调用）
    // ============================================
    function applyI18n() {
        document.title = t('page_title');

        var pt = document.getElementById('pageTitle');
        if (pt) pt.textContent = t('page_title');

        var tl = document.getElementById('totalLabel');
        if (tl) tl.textContent = t('total');

        var ul = document.getElementById('unreadLabel');
        if (ul) ul.textContent = t('unread');

        // 筛选按钮
        var btn = document.querySelector('[data-filter="all"]');
        if (btn) btn.textContent = t('all');
        btn = document.querySelector('[data-filter="unread"]');
        if (btn) btn.textContent = t('unread');
        btn = document.querySelector('[data-filter="login_success"]');
        if (btn) btn.textContent = t('login_notif');
        btn = document.querySelector('[data-filter="booking_success"]');
        if (btn) btn.textContent = t('booking_notif');
        btn = document.querySelector('[data-filter="profile_update"]');
        if (btn) btn.textContent = t('profile_notif');

        // 操作按钮
        var mab = document.getElementById('markAllReadBtn');
        if (mab) mab.innerHTML = '&#10003; ' + t('mark_all_read');
        var cab = document.getElementById('clearAllBtn');
        if (cab) cab.innerHTML = '&#128465; ' + t('clear_all');

        // 空状态
        var et = document.getElementById('emptyTitle');
        if (et) et.textContent = t('empty_title');
        var ed = document.getElementById('emptyDesc');
        if (ed) ed.textContent = t('empty_desc');

        // 模态框
        var mt = document.getElementById('modalTitle');
        if (mt) mt.textContent = t('modal_detail');
        var mr = document.getElementById('modalMarkReadBtn');
        if (mr) mr.textContent = t('mark_read');
        var md = document.getElementById('modalDeleteBtn');
        if (md) md.textContent = t('delete');

        // 确认对话框
        var cc = document.getElementById('confirmCancelBtn');
        if (cc) cc.textContent = t('cancel');
        var co = document.getElementById('confirmOkBtn');
        if (co) co.textContent = t('ok');

        // 语言下拉显示文字
        var langSpan = document.querySelector('#langBtn > span');
        if (langSpan) langSpan.textContent = getLang() === 'en' ? 'EN' : '中文';
        var langTitleSpan = document.querySelector('.lang-header h3');
        if (langTitleSpan) langTitleSpan.textContent = t('lang_title');
    }

    // ============================================
    // NotificationPage 主类
    // ============================================
    function NotificationPage() {
        this.currentFilter   = 'all';
        this.currentUser     = sessionStorage.getItem('username');
        this.userId          = this.currentUser;
        this.confirmCallback = null;
        this.init();
    }

    NotificationPage.prototype.init = function () {
        this.setupEventListeners();
        this.applyI18n();
        this.loadNotifications();
        this.updateUserGreeting();
        this.hideLoadingState();
    };

    NotificationPage.prototype.applyI18n = function () {
        applyI18n();
    };

    NotificationPage.prototype.setupEventListeners = function () {
        var self = this;

        // 筛选按钮
        document.querySelectorAll('.filter-btn').forEach(function (btn) {
            btn.addEventListener('click', function (e) {
                var filter = e.currentTarget.dataset.filter;
                if (filter) self.setActiveFilter(filter);
            });
        });

        // 全部标为已读
        document.getElementById('markAllReadBtn').addEventListener('click', function () {
            self.showConfirmDialog(t('mark_all_confirm_msg'), function () {
                self.markAllAsRead();
            });
        });

        // 清空消息
        document.getElementById('clearAllBtn').addEventListener('click', function () {
            self.showConfirmDialog(t('confirm_clear_msg'), function () {
                self.clearAllMessages();
            });
        });

        // 退出登录
        var logoutBtn = document.getElementById('logoutBtn');
        if (logoutBtn) {
            logoutBtn.addEventListener('click', function () {
                self.showConfirmDialog(t('logout_confirm'), function () {
                    sessionStorage.removeItem('username');
                    sessionStorage.removeItem('role');
                    window.location.href = '../Homepage/index.html';
                });
            });
        }

        // 语言切换下拉
        this.setupLangDropdown();

        // 模态框事件
        this.setupModalEvents();

        // ========== 语言切换监听 ==========
        // 监听 lang.js 广播的事件
        window.addEventListener('notifLangChanged', function () {
            applyI18n();
            self.loadNotifications();
            self.updateUserGreeting();
        });

        // 兼容 localStorage storage 事件（跨标签页同步）
        window.addEventListener('storage', function (e) {
            if (e.key === 'lang') {
                applyI18n();
                self.loadNotifications();
                self.updateUserGreeting();
            }
        });
    };

    NotificationPage.prototype.setupLangDropdown = function () {
        var langBtn      = document.getElementById('langBtn');
        var langDropdown = document.getElementById('langDropdown');
        var closeLangBtn = document.getElementById('closeLangBtn');

        if (!langBtn || !langDropdown) return;

        langBtn.addEventListener('click', function (e) {
            e.preventDefault();
            e.stopPropagation();
            var isOpen = langDropdown.style.display === 'flex';
            langDropdown.style.display = isOpen ? 'none' : 'flex';
        });

        if (closeLangBtn) {
            closeLangBtn.addEventListener('click', function (e) {
                e.stopPropagation();
                langDropdown.style.display = 'none';
            });
        }

        // 点击空白关闭
        document.addEventListener('click', function (e) {
            if (!langBtn.contains(e.target) && !langDropdown.contains(e.target)) {
                langDropdown.style.display = 'none';
            }
        });

        // 语言选项点击
        var langItems = document.querySelectorAll('.lang-item');
        var self = this;
        langItems.forEach(function (item) {
            item.addEventListener('click', function (e) {
                e.preventDefault();
                var nextLang = e.currentTarget.dataset.lang;
                if (nextLang === 'zh' || nextLang === 'en') {
                    // 更新激活状态
                    langItems.forEach(function (i) { i.classList.remove('active'); });
                    e.currentTarget.classList.add('active');

                    // 切换语言（通过 lang.js）
                    if (window.setNotifLang) {
                        window.setNotifLang(nextLang);
                    } else {
                        localStorage.setItem('lang', nextLang);
                        window.dispatchEvent(new CustomEvent('notifLangChanged', { detail: { lang: nextLang } }));
                    }

                    langDropdown.style.display = 'none';
                }
            });
        });
    };

    NotificationPage.prototype.setupModalEvents = function () {
        var self = this;
        var messageModal = document.getElementById('messageModal');
        var confirmModal = document.getElementById('confirmModal');

        document.getElementById('modalCloseBtn').addEventListener('click', function () {
            messageModal.style.display = 'none';
        });

        messageModal.addEventListener('click', function (e) {
            if (e.target === messageModal) messageModal.style.display = 'none';
        });

        document.getElementById('modalMarkReadBtn').addEventListener('click', function () {
            var nid = messageModal.dataset.notificationId;
            if (nid) {
                self.markAsRead(nid);
                messageModal.style.display = 'none';
            }
        });

        document.getElementById('modalDeleteBtn').addEventListener('click', function () {
            var nid = messageModal.dataset.notificationId;
            if (nid) {
                self.showConfirmDialog(t('delete_confirm'), function () {
                    self.deleteMessage(nid);
                    messageModal.style.display = 'none';
                });
            }
        });

        document.getElementById('confirmCancelBtn').addEventListener('click', function () {
            confirmModal.style.display = 'none';
        });

        document.getElementById('confirmOkBtn').addEventListener('click', function () {
            if (self.confirmCallback) self.confirmCallback();
            confirmModal.style.display = 'none';
        });

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
                messageModal.style.display = 'none';
                confirmModal.style.display = 'none';
            }
        });
    };

    NotificationPage.prototype.updateUserGreeting = function () {
        var el = document.getElementById('userGreeting');
        if (el && this.currentUser) {
            // 使用 innerHTML 解析 HTML 实体渲染用户图标
            el.innerHTML = '&#128100; ' + this.currentUser;
        }
    };

    NotificationPage.prototype.loadNotifications = function () {
        if (!window.notificationSystem) return;
        var notifications = window.notificationSystem.getNotifications(this.userId);
        this.renderNotifications(notifications);
        this.updateStats(notifications);
    };

    NotificationPage.prototype.renderNotifications = function (notifications) {
        var self     = this;
        var list     = document.getElementById('messagesList');
        var emptyEl  = document.getElementById('emptyState');
        var filtered = this.filterNotifications(notifications);

        if (filtered.length === 0) {
            list.innerHTML = '';
            emptyEl.style.display = 'block';
            return;
        }

        emptyEl.style.display = 'none';
        list.innerHTML = filtered.map(function (n) { return self.createMessageHTML(n); }).join('');

        list.querySelectorAll('.message-item').forEach(function (item) {
            item.addEventListener('click', function (e) {
                if (!e.target.classList.contains('action-btn')) {
                    self.showMessageDetail(item.dataset.notificationId);
                }
            });
        });

        list.querySelectorAll('.mark-read-btn').forEach(function (btn) {
            btn.addEventListener('click', function (e) {
                e.stopPropagation();
                self.markAsRead(btn.dataset.notificationId);
            });
        });

        list.querySelectorAll('.delete-btn').forEach(function (btn) {
            btn.addEventListener('click', function (e) {
                e.stopPropagation();
                self.showConfirmDialog(t('delete_confirm'), function () {
                    self.deleteMessage(btn.dataset.notificationId);
                });
            });
        });
    };

    NotificationPage.prototype.createMessageHTML = function (notification) {
        var isUnread   = !notification.isRead;
        var icon       = getNotificationIcon(notification.type);
        var time       = formatTime(notification.timestamp);
        var typeText   = getTypeText(notification.type);

        // 渲染通知内容（支持语言动态翻译）
        var rendered = {};
        if (window.notificationSystem && window.notificationSystem.renderNotification) {
            rendered = window.notificationSystem.renderNotification(notification);
        } else {
            rendered = { title: notification.title, message: notification.message };
        }

        return [
            '<div class="message-item' + (isUnread ? ' unread' : '') + '" data-notification-id="' + notification.id + '">',
            '  <div class="message-icon">' + icon + '</div>',
            '  <div class="message-content">',
            '    <div class="message-header">',
            '      <div>',
            '        <div class="message-title">' + (rendered.title || notification.title) + '</div>',
            '        <div class="message-type-badge">' + typeText + '</div>',
            '      </div>',
            '      <div class="message-time">' + time + '</div>',
            '    </div>',
            '    <div class="message-text">' + (rendered.message || notification.message) + '</div>',
            '  </div>',
            '  <div class="message-actions">',
            (isUnread ? '<button class="action-btn mark-read-btn" data-notification-id="' + notification.id + '">' + t('mark_read') + '</button>' : ''),
            '  <button class="action-btn delete-btn" data-notification-id="' + notification.id + '">' + t('delete') + '</button>',
            '  </div>',
            '</div>'
        ].join('');
    };

    NotificationPage.prototype.filterNotifications = function (notifications) {
        if (this.currentFilter === 'all')    return notifications;
        if (this.currentFilter === 'unread') return notifications.filter(function (n) { return !n.isRead; });
        return notifications.filter(function (n) { return n.type === this.currentFilter; }, this);
    };

    NotificationPage.prototype.setActiveFilter = function (filter) {
        this.currentFilter = filter;
        document.querySelectorAll('.filter-btn').forEach(function (btn) {
            btn.classList.remove('active');
        });
        var activeBtn = document.querySelector('[data-filter="' + filter + '"]');
        if (activeBtn) activeBtn.classList.add('active');
        this.loadNotifications();
    };

    NotificationPage.prototype.updateStats = function (notifications) {
        var unread = notifications.filter(function (n) { return !n.isRead; }).length;
        var tc = document.getElementById('totalCount');
        if (tc) tc.textContent = notifications.length;
        var uc = document.getElementById('unreadCount');
        if (uc) uc.textContent = unread;
    };

    NotificationPage.prototype.showMessageDetail = function (notificationId) {
        var self          = this;
        var notifications = window.notificationSystem.getNotifications(this.userId);
        var notification  = notifications.find(function (n) { return n.id == notificationId; });
        if (!notification) return;

        if (!notification.isRead) this.markAsRead(notificationId);

        var modal = document.getElementById('messageModal');
        modal.dataset.notificationId = notificationId;

        // 动态翻译标题和内容
        var rendered = {};
        if (window.notificationSystem && window.notificationSystem.renderNotification) {
            rendered = window.notificationSystem.renderNotification(notification);
        } else {
            rendered = { title: notification.title, message: notification.message };
        }

        document.getElementById('modalTitle').textContent   = rendered.title || notification.title;
        document.getElementById('modalType').textContent    = getTypeText(notification.type);
        document.getElementById('modalTime').textContent    = formatTime(notification.timestamp);
        document.getElementById('modalContent').textContent = rendered.message || notification.message;

        document.getElementById('modalMarkReadBtn').style.display = 'none';
        modal.style.display = 'flex';
    };

    NotificationPage.prototype.markAsRead = function (notificationId) {
        window.notificationSystem.markAsRead(notificationId);
        this.loadNotifications();
    };

    NotificationPage.prototype.markAllAsRead = function () {
        window.notificationSystem.markAllAsRead(this.userId);
        this.loadNotifications();
    };

    NotificationPage.prototype.deleteMessage = function (notificationId) {
        window.notificationSystem.deleteNotification(notificationId);
        this.loadNotifications();
    };

    NotificationPage.prototype.clearAllMessages = function () {
        var notifications = window.notificationSystem.getNotifications(this.userId);
        var self = this;
        notifications.forEach(function (n) {
            window.notificationSystem.deleteNotification(n.id);
        });
        this.loadNotifications();
    };

    NotificationPage.prototype.showConfirmDialog = function (message, callback) {
        this.confirmCallback = callback;
        document.getElementById('confirmMessage').textContent = message;
        document.getElementById('confirmModal').style.display = 'flex';
    };

    NotificationPage.prototype.hideLoadingState = function () {
        var self = this;
        setTimeout(function () {
            var el = document.getElementById('loadingState');
            if (el) el.style.display = 'none';
        }, 400);
    };

    // ============================================
    // 语言切换下拉（与 Book.html 一致）
    // ============================================
    function initLangDropdown() {
        var langBtn     = document.getElementById('langBtn');
        var langDropdown = document.getElementById('langDropdown');
        var closeBtn    = document.getElementById('closeLangBtn');
        var langDisplay = document.getElementById('langDisplay');
        var langItems   = document.querySelectorAll('.lang-item');

        if (!langBtn || !langDropdown) return;

        var currentLang = localStorage.getItem('lang') || 'zh';

        // 切换下拉显示/隐藏
        langBtn.addEventListener('click', function (e) {
            e.preventDefault();
            e.stopPropagation();
            var isOpen = langDropdown.style.display !== 'none';
            langDropdown.style.display = isOpen ? 'none' : 'block';
        });

        // 关闭按钮
        if (closeBtn) {
            closeBtn.addEventListener('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                langDropdown.style.display = 'none';
            });
        }

        // 点击选项切换语言
        langItems.forEach(function (item) {
            item.addEventListener('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                var lang = item.dataset.lang;
                if (!lang) return;

                // 更新本地存储
                localStorage.setItem('lang', lang);
                currentLang = lang;

                // 更新按钮显示文字
                if (langDisplay) {
                    langDisplay.textContent = lang === 'en' ? 'EN' : '中文';
                }

                // 更新 active 状态
                langItems.forEach(function (li) {
                    li.classList.remove('active');
                    if (li.dataset.lang === lang) li.classList.add('active');
                });

                // 关闭下拉
                langDropdown.style.display = 'none';

                // 触发语言切换事件，让通知系统刷新
                window.dispatchEvent(new CustomEvent('notifLangChanged', { detail: { lang: lang } }));
            });
        });

        // 点击空白处关闭
        document.addEventListener('click', function (e) {
            if (!langDropdown.contains(e.target)) {
                langDropdown.style.display = 'none';
            }
        });

        // 初始化 active 状态
        langItems.forEach(function (item) {
            item.classList.remove('active');
            if (item.dataset.lang === currentLang) item.classList.add('active');
        });
        if (langDisplay) {
            langDisplay.textContent = currentLang === 'en' ? 'EN' : '中文';
        }
    }

    // ============================================
    // 初始化
    // ============================================
    document.addEventListener('DOMContentLoaded', function () {
        var currentUser = sessionStorage.getItem('username');
        if (!currentUser) {
            alert(t('please_login') || 'Please log in first.');
            window.location.href = '../login/login.html';
            return;
        }
        new NotificationPage();
        initLangDropdown();
    });

})();
