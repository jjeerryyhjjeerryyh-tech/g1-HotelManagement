<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>消息提醒 - XX酒店</title>
    <link rel="stylesheet" href="notifications.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body>
    <!-- Header（与 Book.html header 风格一致） -->
    <header class="header">
        <div class="header-content">
            <div class="header-left">
                <a class="logo" href="../Homepage/index.html">🏨 91 Hotel</a>
                <div class="header-links">
                    <a href="../Homepage/index.html" class="header-link">
                        <i class="fas fa-home"></i> 首页
                    </a>
                    <a href="../BookOut/Book.html" class="header-link">
                        <i class="fas fa-bed"></i> 房型预订
                    </a>
                    <a href="../profile/profile.html" class="header-link">
                        <i class="fas fa-user"></i> 个人中心
                    </a>
                </div>
            </div>
            <div class="header-links">
                <button class="btn btn-outline" onclick="history.back()">
                    <i class="fas fa-arrow-left"></i> 返回
                </button>
                <span id="userGreeting" class="header-link" style="cursor:default;"></span>
                <button id="logoutBtn" class="btn btn-outline">
                    <i class="fas fa-sign-out-alt"></i> 退出
                </button>
            </div>
        </div>
    </header>

    <!-- 主内容 -->
    <main class="page-wrapper">
        <!-- 页面标题 -->
        <div class="page-header">
            <div class="page-title">
                <span class="title-icon">📬</span>
                <h1 id="pageTitle">消息提醒</h1>
            </div>
            <div class="page-actions">
                <button id="markAllReadBtn" class="btn btn-outline">
                    <i class="fas fa-check-double"></i> 全部标为已读
                </button>
                <button id="clearAllBtn" class="btn btn-outline">
                    <i class="fas fa-trash-alt"></i> 清空消息
                </button>
            </div>
        </div>

        <!-- 统计卡片 -->
        <div class="message-stats">
            <div class="stat-card">
                <span class="stat-number" id="totalCount">0</span>
                <span class="stat-label" id="totalLabel">总消息数</span>
            </div>
            <div class="stat-card">
                <span class="stat-number unread" id="unreadCount">0</span>
                <span class="stat-label" id="unreadLabel">未读消息</span>
            </div>
        </div>

        <!-- 筛选栏 -->
        <div class="message-filters">
            <button class="filter-btn active" data-filter="all">全部</button>
            <button class="filter-btn" data-filter="unread">未读</button>
            <button class="filter-btn" data-filter="login_success">登录通知</button>
            <button class="filter-btn" data-filter="booking_success">预订通知</button>
            <button class="filter-btn" data-filter="profile_update">信息更新</button>
        </div>

        <!-- 消息列表 -->
        <div class="messages-container">
            <div id="messagesList" class="messages-list">
                <!-- 动态生成 -->
            </div>

            <!-- 空状态 -->
            <div id="emptyState" class="empty-state" style="display: none;">
                <div class="empty-icon">📭</div>
                <h3 id="emptyTitle">暂无消息</h3>
                <p id="emptyDesc">您目前没有任何通知消息</p>
            </div>

            <!-- 加载状态 -->
            <div id="loadingState" class="loading-state">
                <div class="loading-spinner"></div>
                <p>正在加载消息...</p>
            </div>
        </div>
    </main>

    <!-- 消息详情模态框 -->
    <div id="messageModal" class="modal-overlay" style="display: none;">
        <div class="modal">
            <div class="modal-header">
                <h3 id="modalTitle">消息详情</h3>
                <button class="modal-close" id="modalCloseBtn">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="modal-body">
                <div class="message-meta">
                    <span class="modal-type" id="modalType"></span>
                    <span class="modal-time" id="modalTime"></span>
                </div>
                <div id="modalContent"></div>
            </div>
            <div class="modal-footer">
                <button id="modalMarkReadBtn" class="btn btn-primary">标为已读</button>
                <button id="modalDeleteBtn" class="btn btn-outline">删除消息</button>
            </div>
        </div>
    </div>

    <!-- 确认对话框 -->
    <div id="confirmModal" class="modal-overlay" style="display: none;">
        <div class="modal">
            <div class="modal-header">
                <h3 id="confirmTitle">确认操作</h3>
            </div>
            <div class="modal-body">
                <p id="confirmMessage">确定要执行此操作吗？</p>
            </div>
            <div class="modal-footer">
                <button id="confirmCancelBtn" class="btn btn-outline">取消</button>
                <button id="confirmOkBtn" class="btn btn-primary">确定</button>
            </div>
        </div>
    </div>

    <!-- 通知系统 -->
    <script src="notificationSystem.js"></script>
    <script src="notifications.js"></script>
</body>
</html>
